// =====================================================================
// RÈGLES DE SÉCURITÉ FIRESTORE — Beats Search
//
// À COLLER MANUELLEMENT DANS :
// Firebase Console → Firestore Database → Règles → Publier
//
// Je ne peux pas publier ces règles moi-même (aucun accès à ton
// projet Firebase) : c'est à toi de les coller et de cliquer sur
// "Publier". Vérifie-les avant de le faire.
//
// Logique :
// - Lecture publique (visiteurs) sur "beats" et "announcements",
//   pour que le site reste consultable par tout le monde.
// - Écriture (créer / modifier / supprimer) réservée UNIQUEMENT au
//   compte producteur authentifié, identifié par son UID Firebase
//   (Na60dUW7OXNcHEAzKImBg17YtC53), pas par un mot de passe en dur.
// =====================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /beats/{beatId} {
      allow read: if true;
      allow write: if request.auth != null
                    && request.auth.uid == "Na60dUW7OXNcHEAzKImBg17YtC53";
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if request.auth != null
                    && request.auth.uid == "Na60dUW7OXNcHEAzKImBg17YtC53";
    }

    // Tout le reste est bloqué par défaut (aucune autre collection
    // n'est autorisée tant qu'elle n'est pas explicitement ajoutée ici).
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
